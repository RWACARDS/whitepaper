{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "RWA NFT Cards",
  "description": "RWA NFT Cards whitepaper - a premium Visa debit card powered by stablecoins",
  "colors": {
    "primary": "#0A0A0A",
    "light": "#FFFFFF",
    "dark": "#171717"
  },
  "logo": {
    "light": "/logo/logo.svg",
    "dark": "/logo/logo.svg"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "light"
  },
  "banner": {
    "content": "Sales start September 29, 2026 - [join the waitlist](https://rwanftcards.com)",
    "dismissible": true
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Join the waitlist",
      "href": "https://rwanftcards.com"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#FFFFFF",
      "dark": "#0A0A0A"
    }
  },
  "styling": {
    "codeblocks": "dark"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "en/introduction",
              "en/trust-and-security"
            ]
          },
          {
            "group": "The Card",
            "pages": [
              "en/product",
              "en/limits-and-fees",
              "en/how-to-get-your-card",
              "en/top-up-and-everyday-use",
              "en/physical-cards",
              "en/gift-certificates"
            ]
          },
          {
            "group": "Partner Program",
            "pages": [
              "en/royalty-program",
              "en/rwa-nftfi-ecosystem"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "en/roadmap",
              "en/faq",
              "en/glossary",
              "en/support",
              "en/legal"
            ]
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search the whitepaper"
  }
}
