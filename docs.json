{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "RWA NFT Cards",
  "description": "RWA NFT Cards whitepaper - a premium Visa debit card powered by stablecoins",
  "colors": {
    "primary": "#0A0A0A",
    "light": "#FFFFFF",
    "dark": "#171717"
  },
  "logo": {
    "light": "/images/apple-touch-icon.png",
    "dark": "/images/apple-touch-icon.png"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "light"
  },
  "banner": {
    "content": "Sales start September 29, 2026 - [join the waitlist](https://rwanftcards.com)",
    "dismissible": true
  },
  "contextual": {
    "options": [
      "chatgpt",
      "claude",
      "grok",
      "aistudio"
    ]
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#FFFFFF",
      "dark": "#0A0A0A"
    }
  },
  "styling": {
    "codeblocks": "dark"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "en/introduction",
              "en/trust-and-security"
            ]
          },
          {
            "group": "The Card",
            "pages": [
              "en/product",
              "en/limits-and-fees",
              "en/how-to-get-your-card",
              "en/top-up-and-everyday-use",
              "en/physical-cards",
              "en/gift-certificates"
            ]
          },
          {
            "group": "Partner Program",
            "pages": [
              "en/royalty-program",
              "en/rwa-nftfi-ecosystem"
            ]
          },
          {
            "group": "Resources",
            "pages": [
              "en/roadmap",
              "en/faq",
              "en/glossary",
              "en/support",
              "en/legal"
            ]
          }
        ]
      },
      {
        "language": "ru",
        "groups": [
          {
            "group": "Обзор",
            "pages": [
              "ru/introduction",
              "ru/trust-and-security"
            ]
          },
          {
            "group": "Карта",
            "pages": [
              "ru/product",
              "ru/limits-and-fees",
              "ru/how-to-get-your-card",
              "ru/top-up-and-everyday-use",
              "ru/physical-cards",
              "ru/gift-certificates"
            ]
          },
          {
            "group": "Партнёрская программа",
            "pages": [
              "ru/royalty-program",
              "ru/rwa-nftfi-ecosystem"
            ]
          },
          {
            "group": "Ресурсы",
            "pages": [
              "ru/roadmap",
              "ru/faq",
              "ru/glossary",
              "ru/support",
              "ru/legal"
            ]
          }
        ]
      }
    ]
  },
  "search": {
    "prompt": "Search the whitepaper"
  }
}
